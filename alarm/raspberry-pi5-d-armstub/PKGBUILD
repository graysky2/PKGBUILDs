pkgname=raspberry-pi5-d-armstub
pkgver=20240918
_commit=fc45bc492dd655f9ea4893a384527341a48cf03d
pkgrel=1
pkgdesc="ARM Trusted Firmware BL31 and D-stepping boot config for Raspberry Pi 5"
arch=(any)
url="https://github.com/raspberrypi/arm-trusted-firmware"
license=(BSD-3-Clause)
conflicts=(linux-rpi linux-rpi-16k raspberry-pi5-armstub uboot-raspberrypi)
backup=(boot/config.txt)
options=(!strip !buildflags)
source=("arm-trusted-firmware-${_commit:0:10}.tar.gz::https://github.com/raspberrypi/arm-trusted-firmware/archive/${_commit}.tar.gz"
        'config.txt')
sha256sums=('53478def88dbd35f7600d75ab7f7444a48b68fb2b380ef2145ce99812d8c80d0'
            '5376d2366b0f51530d0fb41a68e6995a8f614af9fcd6d9b90fb8392d17671764')

build() {
  cd "arm-trusted-firmware-${_commit}"
  make PLAT=rpi5 bl31
}

package() {
  install -Dm644 "arm-trusted-firmware-${_commit}/build/rpi5/release/bl31.bin" \
    "${pkgdir}/boot/armstub8-2712.bin"
  install -Dm644 ../config.txt "${pkgdir}/boot/config.txt"
}
