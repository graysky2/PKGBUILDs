From 05a52008c6b8b8ed7d432f55d1091af8e40c66a0 Mon Sep 17 00:00:00 2001
From: graysky <therealgraysky@proton.me>
Date: Sun, 3 Mar 2024 04:09:46 -0500
Subject: [PATCH 10/10] arch-nspawn: fix setarch for armv7h

---
 src/arch-nspawn.in | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/arch-nspawn.in b/src/arch-nspawn.in
index dddae92dbb0e..d7e52818cf51 100644
--- a/src/arch-nspawn.in
+++ b/src/arch-nspawn.in
@@ -146,6 +146,9 @@ copy_hostconf
 eval "$(grep -a '^CARCH=' "$working_dir/etc/makepkg.conf")"
 
 [[ -z $nosetarch ]] || unset CARCH
+if [[ $CARCH = "armv7h" ]]; then
+	CARCH="armv7l"
+fi
 if [[ -f "@pkgdatadir@/setarch-aliases.d/${CARCH}" ]]; then
 	read -r set_arch < "@pkgdatadir@/setarch-aliases.d/${CARCH}"
 else
